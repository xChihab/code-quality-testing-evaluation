{
    "name": "frontend",
    "version": "1.0.0",
    "scripts": {
        "start": "react-scripts start",
        "build": "react-scripts build",
        "test": "react-scripts test --watchAll=false --passWithNoTests",
        "test:coverage": "react-scripts test --watchAll=false --coverage --passWithNoTests",
        "lint": "echo \"No lint specified\" && exit 0"
    },
    "jest": {
        "collectCoverageFrom": [
            "src/**/*.{js,jsx,ts,tsx}",
            "!src/index.js"
        ],
        "coverageReporters": [
            "text",
            "lcov",
            "clover",
            "html"
        ],
        "coverageThreshold": {
            "global": {
                "statements": 80,
                "branches": 60,
                "functions": 70,
                "lines": 80
            }
        }
    },
    "dependencies": {
        "axios": "^1.12.2",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.30.1",
        "react-scripts": "^5.0.1",
        "web-vitals": "^5.1.0"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7"
    }
}
